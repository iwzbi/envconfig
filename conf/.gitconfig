# Managed by ansible (standup). User-specific settings (name, email, etc.)
# go in ~/.gitconfig.local — not managed, won't be overwritten.
[init]
    defaultBranch = main

[pull]
    rebase = true

[rebase]
    autoStash = true

[rerere]
    enabled = true

[push]
    autoSetupRemote = true
    default = current

[fetch]
    prune = true
    pruneTags = true

[diff]
    colorMoved = default
    algorithm = histogram

[merge]
    conflictstyle = diff3

[core]
    pager = delta
    fsmonitor = true
    untrackedcache = true

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

[commit]
    verbose = true

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt

[log]
    date = iso-strict

# Include user-specific config (name, email, tokens) — not managed by ansible.
[include]
    path = ~/.gitconfig.local
