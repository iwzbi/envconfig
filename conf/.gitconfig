# Managed by ansible (envconfig). User-specific settings (name, email, etc.)
# go in ~/.gitconfig.local — not managed, won't be overwritten.
[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    default = current

[diff]
    colorMoved = default

[merge]
    conflictstyle = zdiff3

[core]
    pager = delta

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    side-by-side = true
    line-numbers = true
    syntax-theme = Dracula

# Include user-specific config (name, email, tokens) — not managed by ansible.
[include]
    path = ~/.gitconfig.local
